# Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# DATABASE (Neon PostgreSQL - REQUIRED)
# ============================================
# Pooled connection string (from Neon dashboard → Connection Details → Pooled)
# Format: postgresql://user:password@ep-xxx-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooled) connection string (for Prisma migrations only)
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ============================================
# CLOUDINARY (PDF Storage - REQUIRED)
# ============================================
# Get from: https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# GOOGLE OAUTH (Continue with Google - REQUIRED)
# ============================================
# Get from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# JWT SECRETS (REQUIRED)
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET="your-jwt-secret-at-least-32-chars"
JWT_REFRESH_SECRET="your-refresh-jwt-secret-at-least-32-chars"

# ============================================
# APP CONFIG
# ============================================
# University email domain restriction
ALLOWED_EMAIL_DOMAIN="youruniversity.edu.in"

# SuperAdmin seed credentials
SUPERADMIN_EMAIL="admin@youruniversity.edu.in"
SUPERADMIN_NAME="Super Admin"

# App URL (set to your Vercel domain in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
